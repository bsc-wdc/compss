[Unit]
Description=COMPSs CI Docker cleanup
After=docker.service
# Not Requires=: the script may restart docker, and Requires= would stop this unit with it.
Wants=docker.service

[Service]
Type=oneshot
ExecStart=/usr/local/bin/compss-ci-docker-prune.sh
# On a builder runner keep base images longer so builds stay cache-warm by
# uncommenting:
# Environment=IMAGE_AGE=72h
