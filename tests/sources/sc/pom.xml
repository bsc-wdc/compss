<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- GENERAL INFORMATION -->
    <groupId>es.bsc.compss.tests</groupId>
    <artifactId>compss-sc-tests</artifactId>
    <version>3.4.post2604</version>
    <packaging>pom</packaging>

    <!-- PROJECT INFORMATION -->
    <name>COMP Superscalar SC Tests</name>
    <description>COMPSs Framework Supercomputers Tests</description>
    <url>http://www.bsc.es</url>
    <inceptionYear>2014</inceptionYear>
    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>http://www.apache.org/licenses/LICENSE-2.0.html</url>
        </license>
    </licenses>
    <organization>
        <name>BSC</name>
        <url>http://www.bsc.es</url>
    </organization>

    <!-- PROPERTIES -->
    <properties>
        <compss.version>3.4</compss.version>

        <!-- Code format -->
        <code-format.version>2.12.2</code-format.version>
        <bsc.wdc.formatter.version>1.0.0</bsc.wdc.formatter.version>

        <!-- Maven Plugins -->
        <maven-compiler-plugin.version>3.14.1</maven-compiler-plugin.version>
        <maven-shade-plugin.version>3.6.1</maven-shade-plugin.version>

        <!-- Project encoding -->
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    </properties>

    <!-- REPOSITORIES -->
    <repositories>
        <repository>
            <id>central</id>
            <name>Central Repository</name>
            <url>https://repo.maven.apache.org/maven2/</url>
            <snapshots>
                <enabled>false</enabled>
            </snapshots>
        </repository>
        <repository>
            <id>compss-repo</id>
            <name>BSC Workflows and Distributed Computing group</name>
            <url>https://compss.bsc.es/artifactory/libs-release</url>
        </repository>
    </repositories>

    <pluginRepositories>
        <pluginRepository>
            <releases>
                <updatePolicy>never</updatePolicy>
            </releases>
            <snapshots>
                <enabled>false</enabled>
            </snapshots>
            <id>central</id>
            <name>Central Repository</name>
            <url>https://repo.maven.apache.org/maven2/</url>
        </pluginRepository>
        <pluginRepository>
            <releases>
                <updatePolicy>never</updatePolicy>
            </releases>
            <snapshots>
                <enabled>false</enabled>
            </snapshots>
            <id>compss-repo</id>
            <name>BSC Workflows and Distributed Computing group</name>
            <url>https://compss.bsc.es/artifactory/libs-release</url>
        </pluginRepository>
    </pluginRepositories>

    <!-- DEPENDENCIES MANAGEMENT -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>es.bsc.compss</groupId>
                <artifactId>compss-api</artifactId>
                <version>${compss.version}</version>
            </dependency>
            <dependency>
                <groupId>es.bsc.compss</groupId>
                <artifactId>compss-engine</artifactId>
                <version>${compss.version}</version>
            </dependency>
            <dependency>
                <groupId>es.bsc.compss</groupId>
                <artifactId>compss-resources-commons</artifactId>
                <version>${compss.version}</version>
            </dependency>
            <dependency>
                <groupId>es.bsc.compss</groupId>
                <artifactId>compss-scheduler-commons</artifactId>
                <version>${compss.version}</version>
            </dependency>

            <!-- BSC Streaming -->
            <dependency>
                <groupId>es.bsc.distro-stream-lib</groupId>
                <artifactId>distro-stream</artifactId>
                <version>${streaming.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <!-- BUILD -->
    <build>
        <plugins>
            <!-- Automatic formatter -->
            <plugin>
                <groupId>net.revelc.code.formatter</groupId>
                <artifactId>formatter-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>validate</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>format</goal>
                        </goals>
                        <configuration>
                            <configFile>code_formatter/eclipse-formatter-config.xml</configFile>
                            <overrideConfigCompilerVersion>true</overrideConfigCompilerVersion>
                            <directories>
                                <directory>${project.build.sourceDirectory}</directory>
                                <directory>${project.build.testSourceDirectory}</directory>
                            </directories>
                            <excludes>
                                <exclude>**/jaxb/*.java</exclude>
                            </excludes>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>

        <pluginManagement>
            <plugins>
                <!-- Automatic formatter -->
                <plugin>
                    <groupId>net.revelc.code.formatter</groupId>
                    <artifactId>formatter-maven-plugin</artifactId>
                    <version>${code-format.version}</version>
                    <dependencies>
                        <dependency>
                            <groupId>es.bsc.wdc</groupId>
                            <artifactId>code_formatter</artifactId>
                            <version>${bsc.wdc.formatter.version}</version>
                        </dependency>
                    </dependencies>
                </plugin>

                <!--This plugin's configuration is used to store Eclipse m2e settings only. It has no influence on the Maven build itself. -->
                <plugin>
                    <groupId>org.eclipse.m2e</groupId>
                    <artifactId>lifecycle-mapping</artifactId>
                    <version>1.0.0</version>
                    <configuration>
                        <lifecycleMappingMetadata>
                            <pluginExecutions>
                                <pluginExecution>
                                    <pluginExecutionFilter>
                                        <groupId>org.apache.maven.plugins</groupId>
                                        <artifactId>maven-checkstyle-plugin</artifactId>
                                        <versionRange>[1.0,)</versionRange>
                                        <goals>
                                            <goal>check</goal>
                                        </goals>
                                    </pluginExecutionFilter>
                                    <action>
                                        <ignore/>
                                    </action>
                                </pluginExecution>
                            </pluginExecutions>
                        </lifecycleMappingMetadata>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

    <!-- SUB-MODULES -->
    <modules>
        <module>simple</module>
    </modules>
</project>

