#!/bin/bash -e 
 
  #############################################################
  # Name: buildMN5_acc
  # Description: SCRIPT FOR MareNostrum5 ACC COMPSs BUILD
  # Parameters: <MN5_user> MareNostrum5 user account. Preferable with ssh keys inserted
  #             <FullTmpPath> Tmp path on MareNostrum5 for deployment
  #             <FullTargetPath> Base Target Installation folder on MareNostrum5
  #             [<version>] OPTIONAL: Version for module file
  #############################################################

  ####################
  # FUNCTIONS
  ####################
  usage() {
    echo " Usage: buildMN5_acc <MN_user> <FullTmpPath> <FullTargetPath> [<version>]"
    echo " "
  }


  ####################
  # MAIN
  ####################
  # Get parameters
  if [ $# -eq 1 ]; then
    if [ "$1" == "usage" ]; then
      usage
      exit 0
    fi
  fi
  if [ $# -lt 3 ] || [ $# -gt 4 ]; then
    echo "Incorrect number of parameters"
    usage
    exit 1
  fi

  # SET SCRIPT VARIABLES
  SCRIPT_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
  
  MNuser=$1
  MNtmpDir=$2
  MNtargetDir=$3
  MNversion=$4 # Optional parameter
  MNmoduleDir="/apps/ACC/modulefiles/applications/COMPSs"
  MNloginNode=alogin4.bsc.es # Requires connectivity for downloading Extrae
  MNauxScript=${SCRIPT_DIR}/buildMN5_acc_aux
  PRELOAD_ENV=""
  MNmoduleParams=""

  if [ -n "$MNversion" ] && [ -f "${SCRIPT_DIR}/module.tplt" ]; then
    echo "Version detected and module.tplt found. Passing required parameters to buildSC..."
    MNmoduleParams="${SCRIPT_DIR}/module.tplt ${MNmoduleDir}/${MNversion}"
  fi

  # Perform installation
  cd "${SCRIPT_DIR}"/../commons/
  ./buildSC "${MNuser}" "${MNloginNode}" "${MNtmpDir}" "${MNtargetDir}" "${MNauxScript}" "${PRELOAD_ENV}"  "${MNmoduleParams}"
  exitStatus=$?
  cd "${SCRIPT_DIR}"

  # END
  exit $exitStatus

