#%Module1.0
########################################################
#
# Author: COMPSs Support (support-compss@bsc.es)
#
########################################################

set PROG_NAME            COMPSs
set PROG_VERSION         BRANCH_NAME
set PROG_BASE            /apps/GPP/$PROG_NAME
set PROG_HOME            /apps/GPP/$PROG_NAME/$PROG_VERSION
set PYTHON_ENV_VAR_NAME  COMPSS_PYTHON_VERSION
set JAVA_HOME            /apps/GPP/OPENJDK/21.0.3+9/
# set JAVA_HOME          /apps/GPP/$PROG_NAME/JAVA/jdk-21.0.1/

proc ModulesHelp { } {
    # WARNING! puts stderr does not resolve environment variables.
    #          If you put any, its following text will not be shown.
    puts stderr "----------------------------"
    puts stderr "| COMPSs Programming Model |"
    puts stderr "----------------------------"
    puts stderr ""
    puts stderr "* The Python version to be loaded can be specified by exporting"
    puts stderr "  the COMPSS_PYTHON_VERSION environment variable in your .bashrc"
    puts stderr "  file before loading the COMPSs module."
    puts stderr "      - Supported COMPSS_PYTHON_VERSION values and associated"
    puts stderr "        Python versions:"
    puts stderr "            3 .................. Python 3.12.1"
    puts stderr "            3.12.1 ............. Python 3.12.1"
    puts stderr "            3.12.1-quantum ..... Python 3.12.1 with quantum libraries"
    puts stderr "            3.12.1-rocrate ..... Python 3.12.1 with rocrate libraries"
    puts stderr "            3.8.18 ............. Python 3.8.18"
    puts stderr "            3.9.16 ............. Python 3.9.16"
    puts stderr "            3.10.15 ............ Python 3.10.15"
    puts stderr "            none ............... Do not load Python"
    puts stderr "      - If COMPSS_PYTHON_VERSION is not defined, no python"
    puts stderr "        will be automatically loaded."
    puts stderr "The complete documentation can be found in compss.bsc.es"
    puts stderr ""
    puts stderr "Please, execute \"enqueue_compss -h\" to get further information."
    puts stderr ""
    puts stderr "COMPSs Support: support-compss@bsc.es"
}

# Tests of consistency
# --------------------
# This application cannot be loaded if another $PROG_NAME modulefile was previously loaded

family ${PROG_NAME}
conflict ${PROG_NAME}

# Load necessary modules
# ----------------------

# Load requirements
module load intel/2023.2.0 impi/2021.10.0 mkl/2023.2.0 oneapi/2023.2.0
module load java-openjdk/21.0.3+9
module load papi
module load R/4.6.1  

# Load the appropriate Python depending on the COMPSS_PYTHON_VERSION environment variable.
if { [info exists env(${PYTHON_ENV_VAR_NAME})] } {
   # puts stderr "User defined explicitly the Python version to use with COMPSS_PYTHON_VERSION environment variable."
   if { $env(${PYTHON_ENV_VAR_NAME}) == "3" } {
       # puts stderr "Loading Python 3.12.1"
       module load hdf5/1.14.1-2 python/3.12.1
       prepend-path  PYTHONPATH  $PROG_BASE/TOOLS/cli/lib
       prepend-path  PATH        $PROG_BASE/TOOLS/cli/bin
   } elseif { $env(${PYTHON_ENV_VAR_NAME}) == "3.12.1" } {
       # puts stderr "Loading Python 3.12.1"
       module load hdf5/1.14.1-2 python/3.12.1
       prepend-path  PYTHONPATH  $PROG_BASE/TOOLS/cli/lib
       prepend-path  PATH        $PROG_BASE/TOOLS/cli/bin
   } elseif { $env(${PYTHON_ENV_VAR_NAME}) == "3.12.1-quantum" } {
       # puts stderr "Loading Python 3.12.1-quantum"
       module load hdf5/1.14.1-2 python/3.12.1
       prepend-path  PATH        $PROG_BASE/TOOLS/cli/bin
       prepend-path  PYTHONPATH  $PROG_BASE/TOOLS/cli/lib
       prepend-path  PATH        /apps/ACC/COMPSs/LIBRARIES/python/python3.12/bin
       prepend-path  PYTHONPATH  /apps/ACC/COMPSs/LIBRARIES/python/python3.12/site-packages
       prepend-path  PYTHONPATH  /apps/GPP/PYTHON/3.12.1/INTEL/lib/python3.12/site-packages/networkx/classes/
   } elseif { $env(${PYTHON_ENV_VAR_NAME}) == "3.12.1-rocrate" } {
       # puts stderr "Loading Python 3.12.1"
       module load hdf5/1.14.1-2 python/3.12.1
       prepend-path  PATH        $PROG_BASE/TOOLS/cli/bin
       prepend-path  PYTHONPATH  $PROG_BASE/TOOLS/cli/lib
       prepend-path  PYTHONPATH  $PROG_BASE/LIBRARIES/rocrate/python3.12/site-packages
       prepend-path  PATH        $PROG_BASE/LIBRARIES/rocrate/python3.12/bin
   } elseif { $env(${PYTHON_ENV_VAR_NAME}) == "3.10.15" } {
       # puts stderr "Loading Python 3.10.15"
       module load python/3.10.15
       prepend-path  PATH        $PROG_BASE/TOOLS/cli/bin
       prepend-path  PYTHONPATH  $PROG_BASE/TOOLS/cli/lib
       prepend-path  PYTHONPATH  $PROG_BASE/LIBRARIES/rocrate/python3.10/site-packages
       prepend-path  PATH        $PROG_BASE/LIBRARIES/rocrate/python3.10/bin
       #prepend-path  PYTHONPATH  $PROG_HOME/cli/lib/python3.10/site-packages/
   } elseif { $env(${PYTHON_ENV_VAR_NAME}) == "3.9.16" } {
       # puts stderr "Loading Python 3.9.16"
       module load python/3.9.16
       module load python/3.10.15
       prepend-path  PATH        $PROG_BASE/TOOLS/cli/bin
       prepend-path  PYTHONPATH  $PROG_BASE/TOOLS/cli/lib
       prepend-path  PYTHONPATH  $PROG_BASE/LIBRARIES/rocrate/python3.9/site-packages
       prepend-path  PATH        $PROG_BASE/LIBRARIES/rocrate/python3.9/bin
   } elseif { $env(${PYTHON_ENV_VAR_NAME}) == "3.8.18" } {
       # puts stderr "Loading Python 3.8.18"
       module load python/3.8.18
       module load python/3.10.15
       prepend-path  PATH        $PROG_BASE/TOOLS/cli/bin
       prepend-path  PYTHONPATH  $PROG_BASE/TOOLS/cli/lib
       prepend-path  PYTHONPATH  $PROG_BASE/LIBRARIES/rocrate/python3.8/site-packages
       prepend-path  PATH        $PROG_BASE/LIBRARIES/rocrate/python3.8/bin
   } else {
       puts stderr "WARNING: Unrecognized Python version. Please choose a supported value for COMPSS_PYTHON_VERSION environment variable (module help $PROG_NAME/$PROG_VERSION)."
       puts stderr "         NOT Loading any Python for COMPSs - the user must load its own."
   }
} else {
   # Check python version
   if { [is-loaded python] } {
       puts stderr "Using already loaded Python"
   } else {
      puts stderr "Python not found. Please load a Python module"
   }
}

### This shows info about loaded/unloaded module
if { [module-info mode] != "whatis" } {
   puts stderr "[module-info mode] [module-info name] (PATH, CLASSPATH, MANPATH, GAT_LOCATION, COMPSS_HOME, JAVA_HOME, JAVA_TOOL_OPTIONS, LDFLAGS, CPPFLAGS)"
}

# MONITOR
prepend-path  PATH               $PROG_BASE/TOOLS/MONITOR/
setenv        COMPSS_MONITOR     $PROG_BASE/TOOLS/MONITOR/
# BINDING-COMMONS
prepend-path  LD_LIBRARY_PATH    $PROG_HOME/Bindings/bindings-common/lib
# RCOMPSS
prepend-path  R_LIBS_USER        $PROG_HOME/Bindings/RCOMPSs/user_libs
# PYTHON BINDING
prepend-path  PYTHONPATH         $PROG_HOME/Bindings/python/3/
# JAVA RUNTIME
setenv	      JAVA_HOME          $JAVA_HOME/
prepend-path  PATH               $JAVA_HOME/bin
prepend-path  PATH               $PROG_HOME/Runtime/scripts/user
prepend-path  PATH               $PROG_HOME/Runtime/scripts/utils
prepend-path  CLASSPATH          $PROG_HOME/Runtime/compss-engine.jar
prepend-path  MANPATH            $PROG_HOME/Doc
setenv        COMPSS_HOME        $PROG_HOME
setenv        JAVA_TOOL_OPTIONS  -Xss4m
setenv        SLURM_OVERLAP      1
setenv        COMPSS_MPIRUN_TYPE impi
setenv	      COMPSS_WORKER_INIT_TIMEOUT 360000
# EAR
# module use /gpfs/projects/bsc19/ePyCOMPSs/ear5.0.pycompss.June6/etc/module
# setenv  EAR_CPU_TDP  350
setenv  EAR_LITE     true
#module load ear/ear
module load ear-tools/ear-lite/5.0
setenv  SLURM_COMP_PLUGIN  0

# Alias
# ---------------------------------

set-alias get_COMPSS_SS26_TUTORIAL  "cp -r /apps/GPP/COMPSs/TUTORIALS/2026_ACM_SUMMER_SCHOOL_MN5/source ."
