# INSTALLS ALL THE NECESSARY JARS FOR AN ADAPTOR.
# REQUIRES 2 PARAMETERS:
#  $1 THE PATH TO THE COMPILED ADAPTOR ROOT FOLDER
#  $2 PATH WHERE TO INSTALL THE ADAPTOR
install_adaptor() {
    adaptor_name=$(basename "$1")
    log_info "------ Copying ${adaptor_name} adaptor"
    if [ -d "$1"/master/ ]; then
      mkdir "$2/${adaptor_name}"
      mkdir "$2/${adaptor_name}"/master
      cp "$1"/master/*.jar "$2"/"${adaptor_name}"/master
      if [ -f "$1"/master/properties ]; then
        cp "$1"/master/properties "$2"/"${adaptor_name}"/master
      fi
    fi
    if [ -d "$1"/worker/ ]; then
      mkdir "$2/${adaptor_name}"/worker
      cp "$1"/worker/*.jar "$2"/"${adaptor_name}"/worker
    fi
    if [ -f "$1"/worker/properties ]; then
      cp "$1"/worker/properties "$2"/"${adaptor_name}"/worker
    fi
    if [ -d "$1"/scripts/ ]; then
      mkdir -p "${targetDir}"/Runtime/scripts/system/adaptors/"${adaptor_name}"
      cp -r "$1"/scripts/* "${targetDir}"/Runtime/scripts/system/adaptors/"${adaptor_name}"
    fi
}

# PRIVATE FUNCTION TO CHECK IF A COMMAND IS AVAILABLE
# Currently to check if python3 exist, to decide wether
# to install one, the other, or both.
command_exists () {
    type "$1" &> /dev/null ;
}

# Returns the version stamp for a dependency.
# Uses the git submodule commit hash when available (precise, invalidates on
# submodule updates), otherwise falls back to the given version string.
get_dep_version() {
  local submodule_path="$1"
  local fallback_version="$2"
  local commit
  commit=$(git -C "${SOURCES_DIR}" ls-files --stage -- "${submodule_path}" 2>/dev/null | awk '{print $2}')
  if [ -n "${commit}" ]; then
    echo "${commit}"
  else
    echo "${fallback_version}"
  fi
}

# Returns 0 (true) if the cache directory exists and its stamp matches the
# expected version, meaning the dependency can be reused without rebuilding.
dep_cache_valid() {
  local cache_dir="$1"
  local expected_version="$2"
  if [ ! -d "${cache_dir}" ]; then return 1; fi
  local cached_version
  cached_version=$(cat "${cache_dir}/.compss_dep_version" 2>/dev/null || echo "")
  [ "${cached_version}" = "${expected_version}" ]
}

# Writes the version stamp into a cache directory so future builds can
# detect whether the cached content is still valid.
write_dep_version() {
  local cache_dir="$1"
  local version="$2"
  echo "${version}" > "${cache_dir}/.compss_dep_version"
}

install_compss() {
  # Set Maven quiet flag and make/binding quiet redirect
  if [ "${quiet}" == "true" ]; then
    mvnQuiet="-q"
    export MAKEFLAGS="-s"
    bindingOut="/dev/null"
  else
    mvnQuiet=""
    bindingOut="/dev/stdout"
  fi

  # Parallelise Maven builds across available cores (Maven CLI flag, not a JVM option)
  mvnParallel="-T 1C"

  # COMPILE
  log_info "- Compile sources"
  cd "${SOURCES_DIR}"
  touch compss/runtime/config/xml/projects/project_schema.xsd
  touch compss/runtime/config/xml/resources/resources_schema.xsd
  if [ "${user_exec}" == "${DEFAULT_USER}" ]; then
    log_info "   (as root)"
    mvn ${mvnQuiet} ${mvnParallel} -U clean install ${mvnTests}
  else
    log_info "   (as user ${user_exec})"
    sudo -E -u "${user_exec}" mvn ${mvnQuiet} ${mvnParallel} clean install ${mvnTests}
  fi
  cd "${SCRIPT_DIR}"

  # COMPILE Storage
  log_info "- Compile storage implementations"
  cd "${SOURCES_DIR}/utils/storage/redisPSCO"
  if [ "${user_exec}" == "${DEFAULT_USER}" ]; then
    log_info "   (as root)"
    ./make_bundle.sh > "${bindingOut}" 2>&1 && :
  else
    log_info "   (as user ${user_exec})"
    sudo -E -u "${user_exec}" ./make_bundle.sh > "${bindingOut}" 2>&1 && :
  fi
  ev=$?
  if [ $ev -ne 0 ]; then
    echo "ERROR: Failed to build storage bundle"
    exit 1
  fi
  cd "${SCRIPT_DIR}"

  # CHECKING pycodestyle IN BINDING - only if 'pycodestyle' is available (MUST be in the test infrastructure)
  if [ "${pycompss}" == "true" ]; then
    if [ "${python_style}" == "true" ]; then
      log_info "- Checking pycodestyle in Python Binding"
      if command_exists "pycodestyle" ; then
        cd "${SOURCES_DIR}/compss/programming_model/bindings/python/scripts/style"
        env $PATH=PATH ./check_code.sh
        ev=$?
        if [ $ev -ne 0 ]; then
          echo "ERROR: Python binding pycodestyle errors. Please, fix them and reinstall."
          cd "${SCRIPT_DIR}"
          exit 1
        fi
        log_info "  - Python Binding format is OK."
        cd "${SCRIPT_DIR}"
      else
        echo "WARNING: Could not check pycodestyle format of Python Binding (pycodestyle not installed)."
        exit 1
      fi
      log_info "- Checking pydocstyle in Python Binding"
      if command_exists "pydocstyle" ; then
        cd "${SOURCES_DIR}/compss/programming_model/bindings/python/scripts/style"
        env $PATH=PATH ./check_documentation.sh
        ev=$?
        if [ $ev -ne 0 ]; then
          echo "ERROR: Python binding pydocstyle errors. Please, fix them and reinstall."
          cd "${SCRIPT_DIR}"
          exit 1
        fi
        log_info "  - Python Binding code documentation is OK."
        cd "${SCRIPT_DIR}"
      else
        echo "WARNING: Could not check pydocstyle format of Python Binding (pydocstyle not installed)."
        exit 1
      fi
      log_info "- Checking Black in Python Binding"
      if command_exists "black" ; then
        cd "${SOURCES_DIR}/compss/programming_model/bindings/python/scripts/style"
        env $PATH=PATH ./check_black.sh
        ev=$?
        if [ $ev -ne 0 ]; then
          echo "ERROR: Python binding Black errors. Please, fix them and reinstall."
          cd "${SCRIPT_DIR}"
          exit 1
        fi
        log_info "  - Python Binding Black format is OK."
        cd "${SCRIPT_DIR}"
      else
        echo "WARNING: Could not check Black format of Python Binding (black not installed)."
        exit 1
      fi
    else
      log_info "SKIP: Skipping Python style check."
    fi

    # Run unittests
    if [ "${unittests}" == "true" ]; then
      log_info " - Run Python Binding Unittests"
      # These tests do not need to be installed
      cd "${SOURCES_DIR}/compss/programming_model/bindings/python/scripts/test"
      env $PATH=PATH ./run_unittests.sh --no-integration-unittests --no-jupyter-unittests
      ev=$?
      if [ $ev -ne 0 ]; then
        echo "ERROR: Python binding unittests failed. Please, fix them and reinstall."
        cd "${SCRIPT_DIR}"
        exit 1
      fi
      log_info "  - Python Binding unittests is OK."
      cd "${SCRIPT_DIR}"
    else
      log_info "SKIP: Skipping PyCOMPSs binding unittests."
    fi

    if [ "${pycompss_compile}" == "true" ]; then
      log_info "- Checking mypy in Python Binding"
      specific_python_command="python3"
      specific_python_command_complete_version=$(${specific_python_command} -V 2>&1)
      specific_python_collapsed_version=$(echo "${specific_python_command_complete_version}" | cut -d ' ' -f 2 | cut -d '.' -f 1,2 | sed -e 's/\.//g')
      if [ "${specific_python_collapsed_version}" -ge "38" ]; then
        if command_exists "mypy" ; then
          cd "${SOURCES_DIR}/compss/programming_model/bindings/python/scripts/compilation"
          env $PATH=PATH ./check.sh
          ev=$?
          if [ $ev -ne 0 ]; then
            echo "ERROR: Python binding mypy errors. Please, fix them and reinstall."
            cd "${SCRIPT_DIR}"
            exit 1
          fi
          log_info "  - Python Binding typing is OK."
          cd "${SCRIPT_DIR}"
        else
          echo "WARNING: Could not check typing of Python Binding (mypy not installed)."
          exit 1
        fi
      else
        echo "WARNING: Could not check typing of Python Binding (Python version required > 3.8)."
        exit 1
      fi
    else
      log_info "SKIP: Skipping PyCOMPSs binding compilation with mypy."
    fi
  fi

  # COPY TRUNK
  log_info "- Copy trunk to tmpdir"
  rm -rf "${TMP_DIR}"
  mkdir -p "${TMP_DIR}"
  cp "${SOURCES_DIR}/changelog" "${TMP_DIR}"
  cp -r "${SOURCES_DIR}/compss" "${TMP_DIR}"
  cp -r "${SOURCES_DIR}/dependencies" "${TMP_DIR}"
  cp -r "${SOURCES_DIR}/files" "${TMP_DIR}"
  cp -r "${SOURCES_DIR}/utils" "${TMP_DIR}"
  cp -r "${SOURCES_DIR}/builders/specs/cli" "${TMP_DIR}"
  cp "${SOURCES_DIR}/LICENSE" "${TMP_DIR}"
  cp "${SOURCES_DIR}/NOTICE" "${TMP_DIR}"
  cp "${SOURCES_DIR}/pom.xml" "${TMP_DIR}"
  cp "${SOURCES_DIR}/README.md" "${TMP_DIR}"
  cp "${SOURCES_DIR}/RELEASE_NOTES" "${TMP_DIR}"
  find "${TMP_DIR}" -name ".git*" -print0 -exec rm -rf {} \; 2>/dev/null | cat > /dev/null # Clean git files

  # CLEAN TRUNK COMPILATION
  if [ "${user_exec}" == "${DEFAULT_USER}" ]; then
    log_info "- Clean sources"
    cd "${SOURCES_DIR}"
    mvn ${mvnQuiet} -U clean
    cd "${SCRIPT_DIR}"
  fi

  # CREATE TARGET FOLDER
  log_info "- Create target folder"
  rm -rf ${targetDir}/Bindings
  mkdir -p ${targetDir}/Bindings/bindings-common
  mkdir -p ${targetDir}/Dependencies # keep installed dependencies
  rm -rf ${targetDir}/Doc
  mkdir -p ${targetDir}/Doc
  rm -rf ${targetDir}/Runtime
  mkdir -p ${targetDir}/Runtime/configuration
  mkdir -p ${targetDir}/Runtime/scripts
  mkdir -p ${targetDir}/Runtime/adaptors
  mkdir -p ${targetDir}/Runtime/connectors
  mkdir -p ${targetDir}/Runtime/cloud-conn
  mkdir -p ${targetDir}/Runtime/scheduler
  mkdir -p ${targetDir}/Runtime/checkpointer
  rm -rf ${targetDir}/Tools
  mkdir -p ${targetDir}/Tools/monitor
  mkdir -p ${targetDir}/Tools/storage
  mkdir -p ${targetDir}/Tools/tracing
  mkdir -p ${targetDir}/Tools/reproducibility_service

  # RUNTIME DEPLOYMENT
  log_info "- Copy Runtime deployment files"
  # Doc
  log_info "--- Copy docs"
  cp "${TMP_DIR}/changelog" ${targetDir}
  cp "${TMP_DIR}/LICENSE" ${targetDir}
  cp "${TMP_DIR}/NOTICE" ${targetDir}
  cp "${TMP_DIR}/README.md" ${targetDir}
  cp "${TMP_DIR}/RELEASE_NOTES" ${targetDir}

  # DEPENDENCIES
  log_info "--- Copy dependencies"
  # GAT
  cp -r "${TMP_DIR}/dependencies/JAVA_GAT" ${targetDir}/Dependencies/
  # Paraver CFGs
  cp -r "${TMP_DIR}/files/paraver" ${targetDir}/Dependencies/
  # Extrae
  if [ "$tracing" == "true" ]; then
    extraeDir="${targetDir}/Dependencies/extrae"
    if [ -n "${EXTRAE_HOME}" ] && [ -d "${EXTRAE_HOME}" ]; then
      log_info "--- Using pre-installed Extrae from ${EXTRAE_HOME}"
      [ -d "${extraeDir}" ] || cp -r "${EXTRAE_HOME}/." "${extraeDir}/"
    else
      extrae_ver=$(get_dep_version "dependencies/extrae" "3.5.3")
      extrae_cache="${deps_cache}/extrae"
      if [ -n "${deps_cache}" ] && dep_cache_valid "${extrae_cache}" "${extrae_ver}"; then
        log_info "--- Reusing cached Extrae (${extrae_ver})"
        cp -r "${extrae_cache}/." "${extraeDir}/"
      else
        cd "${TMP_DIR}"/dependencies/
        ./install_extrae.sh "${TMP_DIR}/dependencies/extrae" "${extraeDir}" true > "${bindingOut}" 2>&1
        ev=$?
        if [ $ev -ne 0 ]; then
          echo "ERROR: Failed to install extrae dependency"
          exit 1
        fi
        if [ -n "${deps_cache}" ]; then
          log_info "--- Caching Extrae to ${extrae_cache}"
          mkdir -p "${extrae_cache}"
          cp -r "${extraeDir}/." "${extrae_cache}/"
          write_dep_version "${extrae_cache}" "${extrae_ver}"
        fi
      fi
      cd "${SCRIPT_DIR}"
    fi
  fi
  # DLB
  if [ "$dlb" == "true" ]; then
    dlbDir="${targetDir}/Dependencies/dlb"
    if [ -n "${DLB_HOME}" ] && [ -d "${DLB_HOME}" ]; then
      log_info "--- Using pre-installed DLB from ${DLB_HOME}"
      [ -d "${dlbDir}" ] || cp -r "${DLB_HOME}/." "${dlbDir}/"
    else
      dlb_ver=$(get_dep_version "dependencies/dlb" "3.6.0")
      dlb_cache="${deps_cache}/dlb"
      if [ -n "${deps_cache}" ] && dep_cache_valid "${dlb_cache}" "${dlb_ver}"; then
        log_info "--- Reusing cached DLB (${dlb_ver})"
        cp -r "${dlb_cache}/." "${dlbDir}/"
      else
        cd "${TMP_DIR}"/dependencies/
        ./install_dlb.sh "${TMP_DIR}/dependencies/dlb" ${dlbDir} > "${bindingOut}" 2>&1 # true
        ev=$?
        if [ $ev -ne 0 ]; then
          echo "ERROR: Failed to install dlb dependency"
          exit 1
        fi
        if [ -n "${deps_cache}" ]; then
          log_info "--- Caching DLB to ${dlb_cache}"
          mkdir -p "${dlb_cache}"
          cp -r "${dlbDir}/." "${dlb_cache}/"
          write_dep_version "${dlb_cache}" "${dlb_ver}"
        fi
      fi
      cd "${SCRIPT_DIR}"
    fi
    export DLB_HOME=${dlbDir}
  else
    unset DLB_HOME
  fi
  # Kafka
  if [ "${kafka}" = "true" ]; then
    kafkaDir="${targetDir}/Dependencies/kafka"
    if [ -n "${KAFKA_HOME}" ] && [ -d "${KAFKA_HOME}" ]; then
      log_info "--- Using pre-installed Kafka from ${KAFKA_HOME}"
      [ -d "${kafkaDir}" ] || cp -r "${KAFKA_HOME}/." "${kafkaDir}/"
    else
      kafka_ver=$(get_dep_version "dependencies/kafka" "3.8.0")
      kafka_cache="${deps_cache}/kafka"
      if [ -n "${deps_cache}" ] && dep_cache_valid "${kafka_cache}" "${kafka_ver}"; then
        log_info "--- Reusing cached Kafka (${kafka_ver})"
        cp -r "${kafka_cache}/." "${kafkaDir}/"
      else
        cp -r "${TMP_DIR}"/dependencies/kafka ${targetDir}/Dependencies/
        #cp "${TMP_DIR}"/dependencies/gradle.properties ${kafkaDir}/.

        cd "${targetDir}"/Dependencies/kafka
        if which gradle; then
          ./retry_zinc gradle > "${bindingOut}" 2>&1
          ev=$?
        elif [ -n "${GRADLE_HOME}" ]; then
          ./retry_zinc "${GRADLE_HOME}/bin/gradle" > "${bindingOut}" 2>&1
          ev=$?
        else
          echo "ERROR: Cannot find gradle installation. Please define it in the PATH or set the GRADLE_HOME environment variable"
          exit 1
        fi
        if [ $ev -ne 0 ]; then
          echo "ERROR: Failed to compile Kafka dependency"
          exit 1
        fi
        ./retry_zinc ./gradlew jar > "${bindingOut}" 2>&1
        ev=$?
        if [ $ev -ne 0 ]; then
          echo "ERROR: Failed to build Kafka dependency"
          exit 1
        fi
        if [ -n "${deps_cache}" ]; then
          log_info "--- Caching Kafka to ${kafka_cache}"
          rm -rf "${kafka_cache}"
          mkdir -p "${kafka_cache}"
          # Cache the JARs and bin/ scripts needed at runtime by streams.sh
          find "${kafkaDir}" -path "*/build/libs/*.jar" \
               ! -name "*-test*.jar" ! -name "*-sources.jar" ! -name "*-javadoc.jar" \
               -exec cp {} "${kafka_cache}/" \;
          if [ -d "${kafkaDir}/bin" ]; then
            cp -r "${kafkaDir}/bin" "${kafka_cache}/"
          fi
          write_dep_version "${kafka_cache}" "${kafka_ver}"
        fi
        cd "${SCRIPT_DIR}"
      fi
    fi
  fi

  # CONFIG
  log_info "--- Copy configuration"
  find "${TMP_DIR}"/compss/runtime/config -name src -type d -prune -exec rm -r "{}" \;
  find "${TMP_DIR}"/compss/runtime/config -name target -type d -prune -exec rm -r "{}" \;
  find "${TMP_DIR}"/compss/runtime/config -name pom.xml -delete
  cp -r "${TMP_DIR}"/compss/runtime/config/* ${targetDir}/Runtime/configuration/
  sed -i -e 's#/opt/COMPSs/#'${targetDir}'#g'  ${targetDir}/Runtime/configuration/xml/projects/default_project.xml

  # Scripts
  log_info "--- Copy scripts"
  cp -r "${TMP_DIR}"/compss/runtime/scripts/* ${targetDir}/Runtime/scripts/

  # Adaptors
  log_info "--- Copy adaptors"
  find "${TMP_DIR}/compss/runtime/adaptors" -name pom.xml -delete
  find "${TMP_DIR}/compss/runtime/adaptors" -name "*.iml" -delete
  rm -r "${TMP_DIR}/compss/runtime/adaptors/commons"
  rm -r "${TMP_DIR}/compss/runtime/adaptors/execution"
  rm -r "${TMP_DIR}/compss/runtime/adaptors/engine"
  rm -r "${TMP_DIR}/compss/runtime/adaptors/target"
  path_source=${TMP_DIR}/compss/runtime/adaptors
  path_target=${targetDir}/Runtime/adaptors
  for adaptor in ${path_source}/*; do
    adaptor_name=$(basename "${adaptor}")
    if [ "${adaptor_name}" != "target" ]; then
      install_adaptor "${adaptor}" "${path_target}"
      if [ "${adaptor_name}" == "agent" ]; then
        for agent in ${adaptor}/*; do
          agent_name=$(basename "${agent}")
          if [ "${agent_name}" != "target" ]; then
            install_adaptor "${agent}" "${path_target}"
          fi
        done
      fi
    fi
  done

  # Checkpointer
  log_info "--- Copy checkpointers policies"
  find "${TMP_DIR}/compss/runtime/checkpointer/" -name "*.jar" -exec cp {} ${targetDir}/Runtime/checkpointer/ \;

  # Schedulers
  log_info "--- Copy schedulers"
  rm -r "${TMP_DIR}/compss/runtime/scheduler/commons"
  rm -r "${TMP_DIR}/compss/runtime/scheduler/test"
  find "${TMP_DIR}/compss/runtime/scheduler/" -name "*.jar" -exec cp {} ${targetDir}/Runtime/scheduler/ \;

  # Storage
  log_info "--- Copy storage implementations"
  log_info "------ Copying Redis Storage Implementation"
  cp -r "${TMP_DIR}/utils/storage/redisPSCO/COMPSs-Redis-bundle" "${targetDir}/Tools/storage/redis"

   # Connectors
  log_info "--- Copy Runtime Connectors"
  connectors=$(find "${TMP_DIR}/compss/runtime/resources/" -name "*.jar" | grep -v "cloud-conn")
  for conn in $connectors; do
    cp "$conn" ${targetDir}/Runtime/connectors/
  done
  log_info "--- Copy CONN Connectors"
  connectors=$(find "${TMP_DIR}/compss/runtime/resources/" -name "*.jar" | grep "cloud-conn")
  for conn in $connectors; do
    cp "$conn" ${targetDir}/Runtime/cloud-conn/
  done

  # Engine
  log_info "--- Copy engine"
  cp "${TMP_DIR}/compss/runtime/compss-engine.jar" "${targetDir}/Runtime/"

  # Agent
  log_info "--- Copy Agent"
  cp "${TMP_DIR}/compss/agent/compss-agent-impl.jar" "${targetDir}/Runtime/"

 # Trace operations
  log_info "--- Copy trace modifications"
  cp -r "${TMP_DIR}/compss/tools/tracing/target/compss-tracing.jar" "${targetDir}/Tools/tracing"

  # TOOLS DEPLOYMENT
  if [ "$monitor" == "true" ]; then
    log_info "- Deploying Monitor at Tools"
    TOMCAT_VER="8.5.23" #"7.0.65"
    if [ -n "${TOMCAT_HOME}" ] && [ -d "${TOMCAT_HOME}" ]; then
      log_info "--- Using pre-installed Tomcat from ${TOMCAT_HOME}"
      mkdir -p "${targetDir}/Tools/monitor/apache-tomcat"
      cp -r "${TOMCAT_HOME}/." "${targetDir}/Tools/monitor/apache-tomcat/"
    else
      tomcat_cache="${deps_cache}/tomcat"
      if [ -n "${deps_cache}" ] && dep_cache_valid "${tomcat_cache}" "${TOMCAT_VER}"; then
        log_info "--- Reusing cached Tomcat (${TOMCAT_VER})"
        mkdir -p "${targetDir}/Tools/monitor/apache-tomcat"
        cp -r "${tomcat_cache}/." "${targetDir}/Tools/monitor/apache-tomcat/"
      else
        cd "${TMP_DIR}"
        TOMCAT_PCK_NAME="apache-tomcat-${TOMCAT_VER}.tar.gz"
        TOMCAT_URL="http://compss.bsc.es/repo/apache-tomcat/${TOMCAT_PCK_NAME}"
        wget "${TOMCAT_URL}" > "${bindingOut}" 2>&1
        ev=$?
        if [ $ev -ne 0 ]; then
          echo "ERROR: Failed to download Tomcat from ${TOMCAT_URL}"
          exit 1
        fi
        tar xzf "${TOMCAT_PCK_NAME}"
        cd "${SCRIPT_DIR}"
        mv "${TMP_DIR}/apache-tomcat-$TOMCAT_VER" "${targetDir}/Tools/monitor/apache-tomcat/"
        if [ -n "${deps_cache}" ]; then
          log_info "--- Caching Tomcat to ${tomcat_cache}"
          mkdir -p "${tomcat_cache}"
          cp -r "${targetDir}/Tools/monitor/apache-tomcat/." "${tomcat_cache}/"
          write_dep_version "${tomcat_cache}" "${TOMCAT_VER}"
        fi
      fi
    fi
    rm -rf "${targetDir}"/Tools/monitor/apache-tomcat/webapps/*
    rm -f "${targetDir}"/Tools/monitor/apache-tomcat/conf/server.xml
    cp -r "${TMP_DIR}"/compss/tools/monitor/target/*.war "${targetDir}/Tools/monitor/apache-tomcat/webapps/"
    cp "${TMP_DIR}"/compss/tools/monitor/target/classes/compss-monitor.conf "${targetDir}/Tools/monitor/apache-tomcat/conf/"
    cp "${TMP_DIR}"/compss/tools/monitor/target/classes/server.xml "${targetDir}/Tools/monitor/apache-tomcat/conf/"
    cp "${TMP_DIR}"/compss/tools/monitor/target/classes/*log4j* "${targetDir}/Tools/monitor/"
  fi

  if [ "$jacoco" == "true" ]; then
    log_info "- Deploying Jacoco at Tools"
    JACOCO_VER="0.8.5"
    if [ -n "${JACOCO_HOME}" ] && [ -d "${JACOCO_HOME}" ]; then
      log_info "--- Using pre-installed JaCoCo from ${JACOCO_HOME}"
      mkdir -p "${targetDir}/Tools/jacoco"
      cp -r "${JACOCO_HOME}/." "${targetDir}/Tools/jacoco/"
    else
      jacoco_cache="${deps_cache}/jacoco"
      if [ -n "${deps_cache}" ] && dep_cache_valid "${jacoco_cache}" "${JACOCO_VER}"; then
        log_info "--- Reusing cached JaCoCo (${JACOCO_VER})"
        mkdir -p "${targetDir}/Tools/jacoco"
        cp -r "${jacoco_cache}/." "${targetDir}/Tools/jacoco/"
      else
        cd "${TMP_DIR}"
        JACOCO_PCK_NAME="jacoco-${JACOCO_VER}.zip"
        JACOCO_URL="https://repo1.maven.org/maven2/org/jacoco/jacoco/${JACOCO_VER}/${JACOCO_PCK_NAME}"
        wget "${JACOCO_URL}" > "${bindingOut}" 2>&1
        ev=$?
        if [ $ev -ne 0 ]; then
          echo "ERROR: Failed to download JaCoCo from ${JACOCO_URL}"
          exit 1
        fi
        unzip "${JACOCO_PCK_NAME}" -d jacoco
        cd "${SCRIPT_DIR}"
        mv "${TMP_DIR}/jacoco" "${targetDir}/Tools/"
        if [ -n "${deps_cache}" ]; then
          log_info "--- Caching JaCoCo to ${jacoco_cache}"
          mkdir -p "${jacoco_cache}"
          cp -r "${targetDir}/Tools/jacoco/." "${jacoco_cache}/"
          write_dep_version "${jacoco_cache}" "${JACOCO_VER}"
        fi
      fi
    fi
  fi

  # REPRODUCIBILITY SERVICE
  log_info "--- Deploying Reproducibility Service"
  cp -r "${TMP_DIR}/compss/tools/reproducibility_service/" "${targetDir}/Tools/"

  # BINDINGS DEPLOYMENT
  if [ "${bindings}" == "true" ] || [ "${pycompss}" == "true" ] || [ "${rcompss}" == "true" ]; then
    log_info "- Deploying bindings-common files"
    cd "${TMP_DIR}/compss/programming_model/bindings/bindings-common"
    ./install_common "${targetDir}/Bindings/bindings-common" > "${bindingOut}" 2>&1 && :
    ev=$?
    if [ $ev -ne 0 ]; then
      echo "ERROR: Failed to install bindings-common"
      exit 1
    fi

    if [ "${bindings}" == "true" ]; then
      log_info "- Deploying c-binding files"
      cd "${TMP_DIR}/compss/programming_model/bindings/c"
      ./install "${targetDir}/Bindings/c" "true" > "${bindingOut}" 2>&1 && :
      ev=$?
      if [ $ev -ne 0 ]; then
        echo "ERROR: Failed to install C-binding"
        exit 1
      fi
      mkdir -p ${targetDir}/Runtime/scripts/system/c/
      cp ${targetDir}/Bindings/c/bin/* ${targetDir}/Runtime/scripts/system/c
      cp ./compss_build_app ${targetDir}/Runtime/scripts/user/
      cp -r ./cfgs ${targetDir}/Bindings/c/
    fi

    if [ "${pycompss}" == "true" ]; then
      log_info "- Deploying python-binding files"
      cd "${TMP_DIR}/compss/programming_model/bindings/python"
      if command_exists "python3" ; then
        # Install python binding only for python3
        ./install.sh "${targetDir}/Bindings/python" true python3 > "${bindingOut}" 2>&1 && :
        ev=$?
      else
        # Error no python 3
        echo "ERROR: Could not find python3 command."
        ev=1
      fi
      if [ $ev -ne 0 ]; then
        echo "ERROR: Failed to install Python-binding"
        exit 1
      fi
      cd "${SCRIPT_DIR}"
    fi

    if [ "${rcompss}" == "true" ]; then
      log_info "- Deploying R-binding files"
      cd "${TMP_DIR}/compss/programming_model/bindings/RCOMPSs"
      ./install.sh "${targetDir}/Bindings/RCOMPSs" "${tracing}" > "${bindingOut}" 2>&1 && :
      ev=$?
      if [ $ev -ne 0 ]; then
        echo "ERROR: Failed to install R-binding"
        exit 1
      fi
      cd "${SCRIPT_DIR}"
    fi
  fi

  if [ "$cli" == "true" ]; then
    log_info "- Deploying CLI at Tools"
    cd "${TMP_DIR}/cli/PyCOMPSsCLIResources"
    ./install.sh > "${bindingOut}" 2>&1 && :
    ev=$?
    if [ $ev -ne 0 ]; then
      echo "ERROR: Failed to install CLI"
      exit 1
    fi
    cd "${SCRIPT_DIR}"
  fi

  # ADD RUNCOMPSS TO PROFILE
  if [ "$EUID" -eq 0 ]; then
    # Script has been run as sudo
    # Insert to profile
    envFile=/etc/profile.d/compss.sh
    # Remove any previous version
    if [ -f "$envFile" ]; then
      rm $envFile
    fi
  else
    # Script has been run as normal user
    # Insert to .bashrc or .zshenv (more common on macOS)
    if [[ "$SHELL" == */zsh ]]; then
      envFile=~/.zshenv
    else
      envFile=~/.bashrc
    fi
    # Launch warning
    echo " "
    echo "***************************************************************************"
    echo "* WARNING: Script is not running as sudo. Inserting COMPSs env at ${envFile} *"
    echo "*          COMPSs WILL ONLY BE AVAILABLE FOR USER: $(whoami)              *"
    echo "***************************************************************************"
  fi

  log_info "- Adding runcompss to profile..."
  build_date=$(date "+%Y-%m-%d %H:%M:%S")
  echo " " >> $envFile
  echo "# COMPSs environment variables ${build_date}" >> $envFile
  echo "export PATH=\$PATH:${targetDir}/Runtime/scripts/user:${targetDir}/Runtime/scripts/utils" >> $envFile
  log_info "- Runcompss added to user profile"
  echo " "
  log_info "- Adding compss-engine.jar to profile..."
  echo "export CLASSPATH=\$CLASSPATH:${targetDir}/Runtime/compss-engine.jar" >> $envFile
  log_info "- compss-engine.jar added to user profile"
  echo " "

  if [ "$bindings" == "true" ]; then
    log_info "- Adding c-binaries to profile..."
    echo "export PATH=\$PATH:${targetDir}/Bindings/c/bin" >> $envFile
    log_info "- c-binaries added to user profile"
    echo " "
    log_info "- Adding binding-common to profile..."   # Needed for jupyter notebook
    # Java paths changed since Java 11, from $JAVA_HOME/lib/amd64/server:$JAVA_HOME/jre/lib/amd64/server
    echo "export LD_LIBRARY_PATH=\$LD_LIBRARY_PATH:${targetDir}/Bindings/bindings-common/lib:\$JAVA_HOME/lib/server" >> $envFile
    log_info "- binding-common library added to user profile"
    echo " "
    # Instead of importing it in the envFile, it is done with softlinks from site-packages in python3 (if available) on the installation
    # echo "- Adding PyCOMPSs to user profile..."
    # echo "export PYTHONPATH=\$PYTHONPATH:${targetDir}/Bindings/python/$( python3 -c "import sys; print(sys.version_info[:][0])" )/" >> $envFile
    # echo "- PyCOMPSs added to user profile"
    # echo " "
  fi

  if [ "$dlb" == "true" ]; then
    echo "export DLB_HOME=${DLB_HOME}" >> $envFile
    echo "export PATH=\$PATH:${DLB_HOME}/bin" >> $envFile
    echo "export LD_LIBRARY_PATH=\$LD_LIBRARY_PATH:${DLB_HOME}/lib" >> $envFile
  fi

  # ADD MONITOR SCRIPT TO ETC (only when running as root / system-wide install)
  if [ "$monitor" == "true" ] && [[ "$OSTYPE" != "darwin"* ]] && [ "$EUID" -eq 0 ]; then
    log_info "- Add monitor script to init.d"
    cp "${TMP_DIR}/compss/tools/monitor/scripts/compss-monitor" /etc/init.d/compss-monitor
    chmod 755 /etc/init.d/compss-monitor

    system=$(which chkconfig | cat)
    if [ "$system" != "" ]; then
      # Suse based distrs
      chkconfig --add compss-monitor
    else
      # Debian based distrs
      update-rc.d compss-monitor defaults
    fi
  elif [ "$monitor" == "true" ] && [[ "$OSTYPE" != "darwin"* ]]; then
    log_info "- Skipping init.d monitor registration (not running as root)"
  fi

  # MACOS NEEDED VARIABLES
  if [[ "$(uname)" == "Darwin" ]]; then
    # This is needed to be able to find util-linux tools at the worker (such as setsid)
    arch=$(uname -m)
    log_info "- Adding macOS environment variables for architecture $arch..."
    echo " " >> $envFile
    echo "# COMPSs environment variables for macOS ${arch} ${build_date}" >> $envFile
    echo "export JAVA_HOME=${JAVA_HOME}" >> $envFile
    JAVA_HOME_DIR=$(echo "$JAVA_HOME" | sed 's|/libexec.*||')
    echo "export PATH=$JAVA_HOME_DIR/bin:\$PATH" >> $envFile
    if [[ "$arch" == "x86_64" ]]; then
      # Homebrew packages are at /usr/local/opt
      echo "export PATH=/usr/local/opt/util-linux/bin:\$PATH" >> $envFile
      echo "export PATH=/usr/local/opt/util-linux/sbin:\$PATH" >> $envFile
    elif [[ "$arch" == "arm64" ]]; then
      # Homebrew packages are at /opt/homebrew/opt
      echo "export PATH=/opt/homebrew/opt/util-linux/bin:\$PATH" >> $envFile
      echo "export PATH=/opt/homebrew/opt/util-linux/sbin:\$PATH" >> $envFile
    fi
    log_info "- macOS environment variables for architecture $arch added to user profile"
    echo " "
  fi

  # ERASE TMP FILES
  log_info "- Erase tmp files"
  rm -rf "${TMP_DIR}"

  # SET TARGETDIR PERMISSIONS
  log_info "- Set COMPSs permissions"
  chmod -R 755 ${targetDir}
  chmod -R 777 ${targetDir}/Runtime/configuration/
}


#---------------------------------------------------
# MAIN EXECUTION
#---------------------------------------------------
  get_args "$@"
  check_args
  warn_and_log_parameters
  install_compss

  # END
  echo "Congratulations! COMPSs Runtime Successfully installed!"
  exit 0
