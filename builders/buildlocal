  log_info "- RCOMPSs          = ${rcompss}"
  log_info "- Tracing          = ${tracing}"
  log_info "- Stream Backend   = ${kafka}"
  log_info "- CLI              = ${cli}"
  log_info "- DLB              = ${dlb}"
  log_info "- Unit tests       = ${unittests}"
  log_info "- PyCOMPSs compile = ${pycompss_compile}"
  log_info "- Python style     = ${python_style}"
  log_info "- SCRIPT_DIR       = ${SCRIPT_DIR}"
  log_info "- SOURCES DIR      = ${SOURCES_DIR}"
