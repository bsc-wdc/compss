#!/bin/bash -e

  # Obtain parameters
  output_file=$1
  error_file=$2
  target_log_folder=$3

  # Log files
  runtime_log="${target_log_folder}/runtime.log"
  resources_log="${target_log_folder}/resources.log"
  dataprovenance_log="${target_log_folder}/dataprovenance.log"

  #----------------------------------------------------------------------------------
  # Check output standard out status
  if [ -f "${output_file}" ]; then
    result_expected="PROVENANCE | ENDED WORKFLOW PROVENANCE SCRIPT"
    test_result=$(tail -1 "${output_file}")
    if [ "${result_expected}" != "${test_result}" ]; then
        echo "SOME ERROR WAS FOUND. CHECK ERRORS ABOVE." | tee -a "${output_file}"
        exit 1
    fi
  else
    echo "[ERROR] Output file not found" | tee -a "${output_file}"
    exit 1
  fi
  # Check that ErrorManager has not raised any ERROR or FATAL message
  if [ -f "${error_file}" ]; then
    if grep -E "\\[ERRMGR\\].*(ERROR|FATAL|Shutting down COMPSs)" "${error_file}"; then
      echo "ERROR: ErrorManager has raised a fatal error" | tee -a "${output_file}"
      exit 1
    fi
  else
    # Empty error file, no exceptions could have been raised
    :
  fi
  # Check that the Runtime has not registered any fatal error
  if [ -f "${runtime_log}" ]; then
    if grep -E "ErrorManager\\].*\\[ERRMGR\\].*Error detected. Shutting down COMPSs" "${runtime_log}"; then
      echo "ERROR: ErrorManager has registered a fatal error in the runtime.log" | tee -a "${output_file}"
      exit 1
    fi
  else
    echo "[ERROR] runtime.log not found" | tee -a "${output_file}"
    exit 1
  fi

  #----------------------------------------------------------------------------------
  # Grep for unit test errors (ERROR or FAIL)
  errors=$(cat "${output_file}" "${error_file}" | grep "ERROR" | cat)
  fails=$(cat "${output_file}" "${error_file}" | grep "FAIL" | cat)
  if [ "${errors}" != "" ] || [ "${fails}" != "" ]; then
      echo "ERROR: UNIT TEST RAISED AN ERROR." | tee -a "${output_file}"
      exit 1
  fi


  #----------------------------------------------------------------------------------
  # Message "PROVENANCE | WORKFLOW PROVENANCE GENERATION HAS FAILED" is cached by previous block
  # Check that provenance directory has been generated

  prov_dir=$(cat "${output_file}" | grep "Destination folder" | sed -E 's/^.*: //')
  # echo "DIRECTORY OF GENERATED PROVENANCE IS: ${prov_dir}" | tee -a "${output_file}"

  if [ -d "${prov_dir}" ]; then
    echo "PROVENANCE DIRECTORY ${prov_dir} EXISTS"
    
    # Test all directories inside the provenance directory exist
    
    if [ ! -d "${prov_dir}application_sources/" ]; then
      echo "application_sources/ DIRECTORY DOES NOT EXIST" | tee -a "${output_file}"
      exit 1
    else
      echo "application_sources/ DIRECTORY EXISTS" | tee -a "${output_file}"
    fi
    if [ ! -d "${prov_dir}dataset/" ]; then
      echo "dataset/ DIRECTORY DOES NOT EXIST" | tee -a "${output_file}"
    else
      echo "dataset/ DIRECTORY EXISTS" | tee -a "${output_file}"
      exit 1
    fi
    if [ ! -d "${prov_dir}profiling/" ]; then
      echo "profiling/ DIRECTORY DOES NOT EXIST" | tee -a "${output_file}"
      exit 1
    else
      echo "profiling/ DIRECTORY EXISTS" | tee -a "${output_file}"
    fi
    if [ ! -d "${prov_dir}profiling/" ]; then
      echo "profiling/ DIRECTORY DOES NOT EXIST" | tee -a "${output_file}"
      exit 1
    else
      echo "profiling/ DIRECTORY EXISTS" | tee -a "${output_file}"
    fi

    # Test all files inside the provenance directory exist
    
    if [ ! -f "${prov_dir}complete_graph.svg" ]; then
      echo "complete_graph.svg FILE DOES NOT EXIST" | tee -a "${output_file}"
      exit 1
    else
      echo "complete_graph.svg FILE EXISTS" | tee -a "${output_file}"
    fi
    if [ ! -f "${prov_dir}ro-crate-info.yaml" ]; then
      echo "ro-crate-info.yaml FILE DOES NOT EXIST" | tee -a "${output_file}"
      exit 1
    else
      echo "ro-crate-info.yaml FILE EXISTS" | tee -a "${output_file}"
    fi
    if [ ! -f "${prov_dir}ro-crate-metadata.json" ]; then
      echo "ro-crate-metadata.json FILE DOES NOT EXIST" | tee -a "${output_file}"
      exit 1
    else
      echo "ro-crate-metadata.json FILE EXISTS" | tee -a "${output_file}"
    fi

    # Check if in profiling subdirectory there are cpu.svg and mem.svg files
    # put in a list all the directory within profiling/ and check if cpu.svg and mem.svg exist in each of them
    profiling_subdirs=$(find "${prov_dir}profiling/" -mindepth 1 -maxdepth 1 -type d)
    # if the lenght of profiling_subdirs is greater than 1, check if cpu.svg and mem.svg exist in profiling/ directory as well
    if [ $(echo "${profiling_subdirs}" | wc -l) -gt 1 ]; then
      if [ ! -f "${prov_dir}profiling/cpu.svg" ]; then
        echo "cpu.svg FILE DOES NOT EXIST IN profiling/ DIRECTORY" | tee -a "${output_file}"
        exit 1
      else
        echo "cpu.svg FILE EXISTS IN profiling/ DIRECTORY" | tee -a "${output_file}"
      fi
      if [ ! -f "${prov_dir}profiling/mem.svg" ]; then
        echo "mem.svg FILE DOES NOT EXIST IN profiling/ DIRECTORY" | tee -a "${output_file}"
        exit 1
      else
        echo "mem.svg FILE EXISTS IN profiling/ DIRECTORY" | tee -a "${output_file}"
      fi
    fi
    # Check if cpu.svg and mem.svg exist in each of the subdirectories of profiling/
    for subdir in ${profiling_subdirs}; do
      if [ ! -f "${subdir}/cpu.svg" ]; then
        echo "cpu.svg FILE DOES NOT EXIST IN ${subdir}" | tee -a "${output_file}"
        exit 1
      else
        echo "cpu.svg FILE EXISTS IN ${subdir}" | tee -a "${output_file}"
      fi
      if [ ! -f "${subdir}/mem.svg" ]; then
        echo "mem.svg FILE DOES NOT EXIST IN ${subdir}" | tee -a "${subdir}" | tee -a "${output_file}"
        exit 1
      else
        echo "mem.svg FILE EXISTS IN ${subdir}" | tee -a "${output_file}"
      fi
    done

    
    # Check ro-crate-metadata.json content

    # if jq available: jq '."@graph".[] | select(."@type"==["File","SoftwareSourceCode","ComputationalWorkflow"])' ro-crate-metadata.json
    computational_workflow=$(grep ComputationalWorkflow "${prov_dir}ro-crate-metadata.json" | sed -e 's/^[ \t]*//' -e 's/,\s*$//')
    if [ "${computational_workflow}" != "\"ComputationalWorkflow\"" ]; then
      echo "ro-crate-metadata.json: ComputationalWorkflow NOT FOUND" | tee -a "${output_file}"
      exit 1
    else
      echo "ro-crate-metadata.json: ComputationalWorkflow FOUND" | tee -a "${output_file}"
    fi

    # if jq available: jq '."@graph".[] | select(."@id"=="./").mainEntity' ro-crate-metadata.json
    main_entity=$(grep mainEntity "${prov_dir}ro-crate-metadata.json" | sed -e 's/^[ \t]*//')
    if [ "${main_entity}" != "\"mainEntity\": {" ]; then
      echo "ro-crate-metadata.json: mainEntity NOT FOUND" | tee -a "${output_file}"
      exit 1
    else
      echo "ro-crate-metadata.json: mainEntity FOUND" | tee -a "${output_file}"
    fi 

    # if jq available: jq '."@graph".[] | select(."@type"==["File","ImageObject","WorkflowSketch"])' ro-crate-metadata.json
    workflow_sketch=$(grep WorkflowSketch "${prov_dir}ro-crate-metadata.json" | sed -e 's/^[ \t]*//')
    if [ "${workflow_sketch}" != "\"WorkflowSketch\"" ]; then
      echo "ro-crate-metadata.json: WorkflowSketch NOT FOUND" | tee -a "${output_file}"
      exit 1
    else
      echo "ro-crate-metadata.json: WorkflowSketch FOUND" | tee -a "${output_file}"
    fi

    # if jq available: jq '."@graph".[] | select(."@type"=="CreateAction")' ro-crate-metadata.json
    create_action=$(grep -w "CreateAction" "${prov_dir}ro-crate-metadata.json")
    if [ -z "$create_action" ]; then
      echo "ro-crate-metadata.json: CreateAction NOT FOUND" | tee -a "${output_file}"
      exit 1
    else
      echo "ro-crate-metadata.json: CreateAction FOUND" | tee -a "${output_file}"
    fi

    authors=$(grep author -A 10 "${prov_dir}ro-crate-metadata.json" | grep orcid | wc -l)
    if [ "${authors}" -ne 3 ]; then
      echo "ro-crate-metadata.json: Authors NOT FOUND" | tee -a "${output_file}"
      exit 1
    else
      echo "ro-crate-metadata.json: Authors FOUND" | tee -a "${output_file}"
    fi

    # Check RO-Crate conformsTo versions
    # jq '."@graph".[] | select(."@id"=="./").conformsTo' ro-crate-metadata.json
    # Must be equal to: 
    # [
    #   {
    #     "@id": "https://w3id.org/ro/wfrun/process/0.1"
    #   },
    #   {
    #     "@id": "https://w3id.org/ro/wfrun/workflow/0.1"
    #   },
    #   {
    #     "@id": "https://w3id.org/workflowhub/workflow-ro-crate/1.0"
    #   }
    # ]    

    # RO-Crate check Workflow and Workflow Run profile defined versions
    # jq '."@graph".[] | select(."@type"=="CreativeWork".version)' ro-crate-metadata.json
    # Must be: null, "0.1", "0.1", "1.0"


    #----------------------------------------------------------------------------------
    # Check dataprovenance.log has been generated and follows expected structure
    if [ ! -f "${dataprovenance_log}" ]; then
      echo "dataprovenance.log FILE DOES NOT EXIST" | tee -a "${output_file}"
      exit 1
    fi
    echo "dataprovenance.log FILE EXISTS" | tee -a "${output_file}"
    # File must not be empty
    if [ ! -s "${dataprovenance_log}" ]; then
      echo "dataprovenance.log FILE IS EMPTY" | tee -a "${output_file}"
      exit 1
    fi

    # Read header lines
    version=$(sed -n '1p' "${dataprovenance_log}")
    app_name=$(sed -n '2p' "${dataprovenance_log}")
    starting_timestamp=$(sed -n '3p' "${dataprovenance_log}")

    # Basic header sanity checks
    if ! echo "${version}" | grep -qE '^[0-9]+\.[0-9]+'; then
      echo "dataprovenance.log: First line (version) not found or malformed: ${version}" | tee -a "${output_file}"
      exit 1
    fi
    if ! echo "${app_name}" | grep -qE '^[^[:space:]]+$'; then                          # FIX: no trailing [LABEL]
      echo "dataprovenance.log: Second line (app name) not found or malformed: ${app_name}" | tee -a "${output_file}"
      exit 1
    fi
    if ! echo "${starting_timestamp}" | grep -qE '^[0-9]{4}-[0-9]{2}-[0-9]{2}T.*Z$'; then        # FIX: no trailing [LABEL]
      echo "dataprovenance.log: Third line (starting timestamp) not found or malformed: ${starting_timestamp}" | tee -a "${output_file}"
      exit 1
    fi

    # Locate section boundaries by content — no section header lines exist in the file
    # INPUT/OUTPUT block starts immediately after the 3 header lines
    input_start=4

    # TASKS OUTCOME block starts at the first "task N status ..." line
    tasks_outcome_start=$(grep -n "^task [0-9]\+ status " "${dataprovenance_log}" | head -1 | cut -d: -f1 || true)

    # METHODS STATS block starts at the first line after TASKS OUTCOME that is not a task status line
    methods_stats_start=$(awk -v start="${tasks_outcome_start}" \
      'NR>start && !/^task [0-9]/ { print NR; exit }' "${dataprovenance_log}" || true)

    # ENDING TIME is the very last line of the file
    ending_time_line=$(awk 'END{print NR}' "${dataprovenance_log}")

    if [ -z "${tasks_outcome_start}" ] || [ -z "${methods_stats_start}" ] || [ -z "${ending_time_line}" ]; then
      echo "dataprovenance.log: Required section headers missing" | tee -a "${output_file}"
      exit 1
    fi

    # Ensure sections are in order
    if [ "${input_start}" -ge "${tasks_outcome_start}" ] || [ "${tasks_outcome_start}" -ge "${methods_stats_start}" ] || [ "${methods_stats_start}" -ge "${ending_time_line}" ]; then
      echo "dataprovenance.log: Section headers in unexpected order" | tee -a "${output_file}"
      exit 1
    fi

    # Check that the INPUT/OUTPUT block contains file and task declarations
    files_count=$(sed -n "${input_start},$((tasks_outcome_start-1))p" "${dataprovenance_log}" | grep -cE '^file\s+' || true)
    tasks_count=$(sed -n "${input_start},$((tasks_outcome_start-1))p" "${dataprovenance_log}" | grep -cE '^task\s+[0-9]+' || true)
    if [ "${files_count}" -lt 1 ] || [ "${tasks_count}" -lt 1 ]; then
      echo "dataprovenance.log: No file/task declarations found in INPUT/OUTPUT block" | tee -a "${output_file}"
      exit 1
    fi

    # Check task outcomes in the TASKS OUTCOME block
    outcome_finished_count=$(sed -n "${tasks_outcome_start},$((methods_stats_start-1))p" "${dataprovenance_log}" | grep -cE '^task\s+[0-9]+\s+status\s+FINISHED' || true)
    if [ "${outcome_finished_count}" -lt 1 ]; then
      echo "dataprovenance.log: No 'task ... status FINISHED' lines found in TASKS OUTCOME block" | tee -a "${output_file}"
      exit 1
    fi

    # Check METHODS STATS block contains at least one 'overall' entry
    overall_count=$(sed -n "${methods_stats_start},$((ending_time_line-1))p" "${dataprovenance_log}" | grep -cE '^overall\s+' || true)
    if [ "${overall_count}" -lt 1 ]; then
      echo "dataprovenance.log: METHODS STATS missing overall entries" | tee -a "${output_file}"
      exit 1
    fi

    # Check ending timestamp (last line) looks like ISO8601
    ending_line=$(sed -n "${ending_time_line}p" "${dataprovenance_log}")
    if ! echo "${ending_line}" | grep -qE '^[0-9]{4}-[0-9]{2}-[0-9]{2}T.*Z$'; then    # FIX: no trailing [ENDING TIME]
      echo "dataprovenance.log: Ending timestamp line malformed: ${ending_line}" | tee -a "${output_file}"
      exit 1
    fi

    echo "dataprovenance.log: STRUCTURE OK" | tee -a "${output_file}"


  else
    echo "PROVENANCE DIRECTORY DOES NOT EXIST"
    exit 1
  fi



  #----------------------------------------------------------------------------------
  # Report result status
  exit 0
