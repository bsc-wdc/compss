<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<!-- GENERAL INFORMATION -->
	<artifactId>compss-execution-java-plugin</artifactId>
	<packaging>jar</packaging>
	<parent>
		<groupId>es.bsc.compss</groupId>
		<artifactId>compss-execution-plugins</artifactId>
		<version>4.0.0-alpha.1</version>
	</parent>

	<!-- PROJECT INFORMATION -->
	<name>COMPSs Java Execution Plugin</name>
	<description>
		Plugin to execute Java tasks on a node.
    </description>
	<url>http://www.bsc.es</url>
	<inceptionYear>2015</inceptionYear>
	<licenses>
		<license>
			<name>Apache License, Version 2.0</name>
			<url>http://www.apache.org/licenses/LICENSE-2.0.html</url>
		</license>
	</licenses>
	<organization>
		<name>BSC</name>
		<url>http://www.bsc.es</url>
	</organization>

	<!-- DEPENDENCIES -->
	<dependencies>
        <dependency>
            <groupId>es.bsc.compss</groupId>
            <artifactId>compss-commons</artifactId>
        </dependency>

		<dependency>
			<groupId>es.bsc.compss</groupId>
			<artifactId>compss-execution-api</artifactId>
		</dependency>

		<dependency>
			<groupId>es.bsc.compss</groupId>
			<artifactId>compss-execution-core</artifactId>
		</dependency>

		<!-- Nested tasks -->
		<!-- Runtime API-->
		<dependency>
			<groupId>es.bsc.compss</groupId>
			<artifactId>compss-runtime-api</artifactId>
			<version>${project.version}</version>
			<scope>provided</scope>
		</dependency>

		<!-- Instrumenter -->
		<dependency>
			<groupId>es.bsc.compss</groupId>
			<artifactId>compss-loader</artifactId>
			<version>${project.version}</version>
		</dependency>

		<!-- Test Dependencies -->
		<!-- Classes to validate the behavior of the execution -->
		<dependency>
			<groupId>es.bsc.compss</groupId>
			<artifactId>compss-execution-test-commons</artifactId>
			<version>${project.version}</version>
			<scope>test</scope>
		</dependency>

		<!-- JUnit -->
		<dependency>
			<groupId>junit</groupId>
			<artifactId>junit</artifactId>
			<scope>test</scope>
		</dependency>

	</dependencies>

	<!-- BUILD -->
	<build>
		<finalName>${project.artifactId}</finalName>
	</build>
</project>
