#!/bin/bash

  # Obtain parameters
  COMPSs_exec=$1
  comm=$2
  runcompss_opts=$3
  base_app_dir=$4
  COMPSs_log_folder=$5
  target_log_folder=$6
  retry_num=$7
  execution_envs=$8

  # Global variables
  exit_value=1
  app_name="test_monitor_new.py"

  #----------------------------------------------------------------------------------
  # Generate Project.xml according to system
  sed -i '/<InstallDir>/c<InstallDir>'"${COMPSS_HOME}"'<\/InstallDir>' "${base_app_dir}"/project.xml

  #----------------------------------------------------------------------------------
  # Create all working dir folders
  mkdir -p /tmp/COMPSsWorker01/

  #----------------------------------------------------------------------------------
  # Run application
  echo
  echo "*** RUNNING PYTHON APPLICATION MONITOR NEW"

  for python_interpreter in ${execution_envs}; do
    echo "   - Running with Interpreter: ${python_interpreter}"
    output_log="${target_log_folder}/${app_name}_${python_interpreter}_0${retry_num}.outputlog"
    error_log="${target_log_folder}/${app_name}_${python_interpreter}_0${retry_num}.errorlog"
    specific_log_dir="${COMPSs_log_folder}/${app_name}_${python_interpreter}_0${retry_num}"
    exec_target_log_folder="${target_log_folder}/${app_name}_${python_interpreter}_0${retry_num}"
    capture_dir="${target_log_folder}/${app_name}_${python_interpreter}_0${retry_num}_capture"
    events_file="${capture_dir}/monitored_events.jsonl"
    graph_file="${capture_dir}/graph_events.jsonl"
    port_file="${capture_dir}/port"
    mkdir -p "${exec_target_log_folder}" "${capture_dir}"
    expectedTime=180s

    python_mpi_worker=""
    if [ "$python_interpreter" == 'python3_mpi' ]; then
        python_interpreter="python3"
        python_mpi_worker="--python_mpi_worker=true"
    fi

    python3 "${base_app_dir}/src/monitor_capture.py" serve \
      --events-file "${events_file}" \
      --graph-file "${graph_file}" \
      --port-file "${port_file}" &
    capture_pid=$!

    for _ in $(seq 1 50); do
      if [ -s "${port_file}" ]; then
        break
      fi
      sleep 0.1
    done
    if [ ! -s "${port_file}" ]; then
      echo "[ERROR] Monitor capture server did not start" | tee -a "${output_log}"
      kill "${capture_pid}" 2>/dev/null
      exit 1
    fi

    monitor_port=$(cat "${port_file}")
    monitor_base="http://127.0.0.1:${monitor_port}"
    jvm_monitor_opts="-Dcompss.events.api=${monitor_base}/monitored-events,-Dcompss.graph.api=${monitor_base}/graph-events"

    # shellcheck disable=SC2086
    timeout --signal=2 $expectedTime "${COMPSs_exec}" \
      --project="${base_app_dir}"/project.xml \
      --resources="${base_app_dir}"/resources.xml \
      \
      --comm="$comm" \
      \
      --debug \
      --env_script="${base_app_dir}/src/monitor_env.sh" \
      --tracing=monitor \
      --jvm_master_opts="${jvm_monitor_opts}" \
      --jvm_workers_opts="${jvm_monitor_opts}" \
      ${runcompss_opts} \
      ${python_mpi_worker} \
      \
      --lang=python \
      --python_interpreter="${python_interpreter}" \
      --pythonpath="${base_app_dir}"/src \
      --specific_log_dir="${specific_log_dir}" \
      \
      "${base_app_dir}/src/${app_name}" > >(tee "${output_log}") 2> >(tee "${error_log}" >&2)

    run_status=$?
    sleep 2
    kill "${capture_pid}" 2>/dev/null
    wait "${capture_pid}" 2>/dev/null

    # Copy LOG files
    cp -rf "${specific_log_dir}"/* "${exec_target_log_folder}"
    # Check timeout
    if [[ "${run_status}" = "124" ]]; then
      # Report time out
      echo "[WARNING] Python Application timed out" >> "${output_log}"
      exit_value=124
    elif [[ "${run_status}" != "0" ]]; then
      echo "[ERROR] Python Application failed with exit code ${run_status}" >> "${output_log}"
      exit_value=${run_status}
    else
      # Check result
      "${base_app_dir}"/result "${output_log}" "${error_log}" "${exec_target_log_folder}" "${base_app_dir}" "${events_file}" "${graph_file}"
      exit_value=$?
    fi

    if [ ${exit_value} -ne 0 ]; then
      exit ${exit_value}
    fi
  done

  #----------------------------------------------------------------------------------
  # Return execution status
  exit ${exit_value}
