#!/bin/bash

  # Check if the image is available locally
  if ! docker image inspect "${COMPSS_IMAGE:=tests}" &> /dev/null ; then
    echo "Docker image '${COMPSS_IMAGE}' does not exist. Build it before trying to run the tests with:"
    echo "docker bake --set tests.tags=${COMPSS_IMAGE} tests"
    echo "NOTE: the command should be run at the root of the repository."
    exit 1
  fi

  # Set volumes paths
  docker_host="${DOCKER_HOST:7}"
  docker_sock=/var/run/docker.sock
  master_dir=/root
  worker_dir=/tmp/COMPSsWorker01

  # Run the container — the ENTRYPOINT (compss_entrypoint.sh) handles
  # configure_hosts_insert and starting sshd before exec-ing the CMD.
  if ! docker run -d \
                  --env COMPSS_CONTAINER="${COMPSS_CONTAINER:=tests}" \
                  --env COMPSS_IMAGE="${COMPSS_IMAGE}" \
                  --mount type=bind,src="${docker_host:-${docker_sock}}",dst=${docker_sock} \
                  --mount type=volume,dst=${master_dir} \
                  --mount type=volume,dst=${worker_dir} \
                  --name="${COMPSS_CONTAINER}" \
                  "${COMPSS_IMAGE}" sleep infinity ; then
    echo "Docker container '${COMPSS_CONTAINER}' is already running. Remove it before trying to run the tests with:"
    echo "docker rm -fv ${COMPSS_CONTAINER}"
    exit 1
  fi

  # Execute the tests
  docker exec "${COMPSS_CONTAINER}" /bin/bash -lc \
    'python3 /framework/tests/scripts/tests.py "$@"' \
    _ "$@"
